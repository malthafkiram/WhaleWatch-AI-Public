# Development DB (discrete vars)
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=

# Do NOT copy Postgres PORT=5432 into the Railway web service.
# Leave PORT unset on Railway so the platform injects the HTTP service port.
PORT=

# Production (Sequelize use_env_variable) — must be Railway Postgres URL, not dead Supabase
DATABASE_URL=
NODE_ENV=production

# Keamanan JWT dan Google OAuth
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Sumber Data Coin Utama
COINGECKO_API_KEY=

# Groq API Key (chatbot + analisis AI)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Midtrans
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
